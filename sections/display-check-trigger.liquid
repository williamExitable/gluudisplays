{% comment %}
  Places a button that opens the display check modal. The modal itself is rendered globally
  from theme.liquid, so it can also be opened from a link to #display-check, from any element
  with a data-display-check-open attribute, or with window.GluuDisplayCheck.open().
{% endcomment %}

{{ 'display-check.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="display-check-section{% if section.settings.show_top_border %} display-check-section--bordered{% endif %} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div
      class="display-check-trigger display-check-trigger--{{ section.settings.alignment }}"
      {{ section.shopify_attributes }}
    >
      {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.show_image -%}
        <div class="display-check-trigger__content">
          {%- if section.settings.show_image -%}
            <div class="display-check-trigger__image" style="--display-check-image-width: {{ section.settings.image_width }}px;">
              {%- if section.settings.image != blank -%}
                {%- assign image_sizes = section.settings.image_width | append: 'px' -%}
                {{
                  section.settings.image
                  | image_url: width: 400
                  | image_tag: widths: '100, 200, 300, 400', sizes: image_sizes, alt: section.settings.heading
                }}
              {%- else -%}
                <img
                  src="{{ 'display-check-teaser.jpg' | asset_url }}"
                  alt="{{ section.settings.heading | escape }}"
                  width="1000"
                  height="1000"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="display-check-trigger__heading h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="display-check-trigger__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <button
        type="button"
        class="button{% if section.settings.button_style_secondary %} button--secondary{% endif %}"
        data-display-check-open="section-{{ section.id }}"
        aria-haspopup="dialog"
      >
        {{ section.settings.button_label | escape }}
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Display check",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_top_border",
      "default": true,
      "label": "Show border above the section"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "Show image above the heading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the default display image."
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Image width",
      "default": 90
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Welk display past het beste bij mij?",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Doe de check en ontdek in drie korte vragen welke displays bij jouw situatie passen.</p>",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Doe de check!",
      "label": "Button label"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "Use outline button style"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center",
      "label": "Alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Display check"
    }
  ]
}
{% endschema %}
