{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'section-customer-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer" data-cookieconsent="ignore"></script>
<script src="{{ 'customer-reviews.js' | asset_url }}" defer="defer" data-cookieconsent="ignore"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="customer-reviews color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="customer-reviews__layout">
      <div class="customer-reviews__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="customer-reviews__heading h1">{{ section.settings.heading }}</h2>
        {%- endif -%}

        <div class="customer-reviews__score">
          {% render 'rating-stars', rating: section.settings.rating, rating_max: 10 %}
          <span class="customer-reviews__score-value">
            <strong>{{ section.settings.rating | append: '' | replace: '.', ',' }}</strong> / 10
          </span>
        </div>

        {%- if section.settings.reviews_count > 0 -%}
          <p class="customer-reviews__count">
            Gebaseerd op <strong>{{ section.settings.reviews_count }}</strong> reviews
          </p>
        {%- endif -%}
      </div>

      <customer-reviews-slider class="customer-reviews__slider">
        <div class="swiper">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <article class="customer-reviews__card">
                  {%- if block.settings.author != blank -%}
                    <h3 class="customer-reviews__author h4">{{ block.settings.author }}</h3>
                  {%- endif -%}
                  <div class="customer-reviews__meta">
                    {% render 'rating-stars', rating: block.settings.rating, rating_max: 5 %}
                    {%- if block.settings.date != blank -%}
                      <span class="customer-reviews__date">{{ block.settings.date }}</span>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.text != blank -%}
                    <p class="customer-reviews__text">{{ block.settings.text }}</p>
                  {%- endif -%}
                </article>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <button
          type="button"
          class="customer-reviews__nav customer-reviews__nav--prev"
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        >
          <i class="ph ph-caret-left"></i>
        </button>
        <button
          type="button"
          class="customer-reviews__nav customer-reviews__nav--next"
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          <i class="ph ph-caret-right"></i>
        </button>
      </customer-reviews-slider>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Klantreacties",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Onze klant reacties"
    },
    {
      "type": "range",
      "id": "rating",
      "min": 0,
      "max": 10,
      "step": 0.1,
      "label": "Gemiddelde score (van 10)",
      "default": 9.2
    },
    {
      "type": "number",
      "id": "reviews_count",
      "label": "Aantal reviews",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Naam",
          "default": "Voornaam Achternaam"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Sterren",
          "default": 5
        },
        {
          "type": "text",
          "id": "date",
          "label": "Datum",
          "default": "21-9-2026"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review",
          "default": "De verwachtingen werden volledig vervuld."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Klantreacties",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
