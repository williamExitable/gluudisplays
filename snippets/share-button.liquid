{% comment %}
  Renders share button and question button.
  Accepts:
  - block: {Object} passes in the block information.
  - share_link: {String} url to be added to the input the user will get/copy.

  Usage:
  {% render 'share-button',
    block: block,
    share_link: share_url
  %}
{% endcomment %}
{{ 'share-modal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'share.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'question-form.js' | asset_url }}" defer="defer" data-cookieconsent="ignore"></script>

{%- liquid
  assign share_label = block.settings.share_label | default: 'Delen'
  assign share_title = product.title | default: article.title | default: page_title
  assign share_image = product.featured_image | image_url: width: 1024
  if share_image == blank
    assign share_image = article.image | image_url: width: 1024
  endif

  comment
    Each entry is "modal key|modal title|Shopify Forms form id|heading". The form id is
    the data-forms-id value rendered by the Shopify Forms app block, so the app block can
    be placed anywhere in the section and gets moved into the matching modal. The title is
    always used as the dialog label; only entries marked "show" also render a heading,
    because most of these forms already render their own.
  endcomment
  assign question_modals = 'Question|Stel een vraag|forms-root-1092580,Offerte|Offerte aanvragen|forms-root-1092220,Cheaper|Ergens anders goedkoper?|forms-root-1092639,Showroom|Bezoek onze showroom|forms-root-1092660' | split: ','
  assign contact_url = pages.contact.url | default: '/pages/contact'

  comment
    Label of the Shopify Forms text field that gets prefilled with the article number,
    product title and product URL. The field is hidden from the customer.
  endcomment
  assign question_form_field = 'Product'
  assign question_form_variant = product.selected_or_first_available_variant
-%}

<div id="Share-{{ section.id }}" class="share-button quick-add-hidden" {{ block.shopify_attributes }}>
  <div class="share-button__actions">
    <modal-opener class="share-button__opener no-js-hidden" data-modal="#ShareModal-{{ section.id }}">
      <button class="share-button__button" type="button" aria-haspopup="dialog">
        <i class="ph-fill ph-share-fat" aria-hidden="true"></i>
        <span class="share-button__label">{{ share_label | escape }}</span>
      </button>
    </modal-opener>

    <modal-opener class="share-button__opener no-js-hidden" data-modal="#QuestionModal-{{ section.id }}">
      <button class="share-button__button" type="button" aria-haspopup="dialog">
        <i class="ph-fill ph-chat-dots" aria-hidden="true"></i>
        <span class="share-button__label">Stel een vraag</span>
      </button>
    </modal-opener>
  </div>

  {%- if request.page_type == 'product' -%}
    {% render 'cta-buttons', section: section %}
  {%- endif -%}

  <a href="{{ share_link }}" class="share-button__button no-js" target="_blank" rel="noopener" aria-label="{{ share_label | escape }}">
    <i class="ph-fill ph-share-fat" aria-hidden="true"></i>
    <span class="share-button__label">{{ share_label | escape }}</span>
  </a>

  <modal-dialog id="ShareModal-{{ section.id }}" class="product-popup-modal share-modal">
    <div
      role="dialog"
      aria-label="{{ 'products.product.share' | t }}"
      aria-modal="true"
      class="product-popup-modal__content share-modal__content"
      tabindex="-1"
    >
      <button
        id="ModalClose-Share-{{ section.id }}"
        type="button"
        class="product-popup-modal__toggle"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {% render 'icon-close' %}
      </button>

      <div class="product-popup-modal__content-info share-modal__body">
        <h2 class="h2 share-modal__title">{{ 'products.product.share' | t }}</h2>

        <share-modal class="share-modal__wrapper">
          <div class="share-modal__input-wrap field">
            <input
              type="text"
              class="share-modal__url field__input"
              id="ShareUrl-{{ section.id }}"
              value="{{ share_link }}"
              readonly
            >
            <button
              type="button"
              class="share-button__copy button"
              data-copied-text="{{ 'general.share.success_message' | t }}"
              aria-controls="ShareUrl-{{ section.id }}"
            >
              Kopiëren
            </button>
          </div>

          <div class="share-modal__links">
            <a
              class="share-modal__link"
              href="https://www.facebook.com/sharer.php?u={{ share_link | url_encode }}"
              target="_blank"
              rel="noopener"
              aria-label="{{ 'general.social.alt_text.share_on_facebook' | t }}"
            >
              {% render 'icon-facebook' %}
            </a>
            <a
              class="share-modal__link"
              href="https://twitter.com/intent/tweet?text={{ share_title | url_encode }}&url={{ share_link | url_encode }}"
              target="_blank"
              rel="noopener"
              aria-label="{{ 'general.social.alt_text.share_on_twitter' | t }}"
            >
              {% render 'icon-twitter' %}
            </a>
            <a
              class="share-modal__link"
              href="https://pinterest.com/pin/create/button/?url={{ share_link | url_encode }}{% if share_image != blank %}&media={{ share_image | url_encode }}{% endif %}&description={{ share_title | url_encode }}"
              target="_blank"
              rel="noopener"
              aria-label="{{ 'general.social.alt_text.share_on_pinterest' | t }}"
            >
              {% render 'icon-pinterest' %}
            </a>
          </div>
        </share-modal>
      </div>
    </div>
  </modal-dialog>

  {%- for question_modal in question_modals -%}
    {%- liquid
      assign parts = question_modal | split: '|'
      assign modal_key = parts[0]
      assign modal_title = parts[1]
      assign modal_form_id = parts[2]
      assign modal_heading = parts[3]
    -%}
    <modal-dialog
      id="{{ modal_key }}Modal-{{ section.id }}"
      class="product-popup-modal question-modal"
      data-cookieconsent="ignore"
    >
      <div
        role="dialog"
        aria-label="{{ modal_title | escape }}"
        aria-modal="true"
        class="product-popup-modal__content question-modal__content"
        tabindex="-1"
      >
        <button
          id="ModalClose-{{ modal_key }}-{{ section.id }}"
          type="button"
          class="product-popup-modal__toggle"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon-close' %}
        </button>

        <div class="product-popup-modal__content-info question-modal__body">
          {%- if modal_heading == 'show' -%}
            <h2 class="h2 question-modal__title">{{ modal_title }}</h2>
          {%- endif -%}
          <question-form-embed
            class="question-form__embed"
            data-cookieconsent="ignore"
            data-form-id="{{ modal_form_id }}"
            {%- if product %}
              data-fill-label="{{ question_form_field | escape }}"
              data-fill-hidden
              data-section-id="{{ section.id }}"
              data-sku="{{ question_form_variant.sku | escape }}"
              data-variant-id="{{ question_form_variant.id }}"
              data-product-title="{{ product.title | escape }}"
              data-product-url="{{ product.url | prepend: request.origin }}"
            {%- endif %}
          >
            <p class="question-form__placeholder">Formulier wordt geladen…</p>
            <p class="question-form__fallback">
              Het formulier kan niet worden geladen.
              <a href="{{ contact_url }}">Neem contact met ons op</a>.
            </p>
          </question-form-embed>
        </div>
      </div>
    </modal-dialog>
  {%- endfor -%}
</div>
